# ── Database ────────────────────────────────────────────────────────────────
# Neon serverless Postgres. Copy the "pooled" connection string from the Neon
# dashboard and keep ?sslmode=require on the end.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/skyreach?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate real ones:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGIN="http://localhost:3000"
# Set true only when frontend and backend are on different sites in production.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
# Leave blank for localhost. In production set to a shared parent domain.
COOKIE_DOMAIN=""

# ── OpenSky Network (optional) ──────────────────────────────────────────────
# Anonymous access works but on a smaller daily credit budget. Register an app
# at https://opensky-network.org/ for OAuth2 client credentials.
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""
# How often the server polls OpenSky, in seconds. Every client is served from
# this one cached result, so this — not visitor count — is your credit spend.
LIVE_TRAFFIC_POLL_SECONDS=15

# ── Booking rules ───────────────────────────────────────────────────────────
SEAT_HOLD_MINUTES=10
BOOKING_EXPIRY_MINUTES=15
